---
import '../styles/layout.css';
import '../styles/viewToggle.css';
import Font from 'astro/components/Font.astro';
import { ClientRouter } from 'astro:transitions';
import Topbar from '../components/Topbar.astro';
import SvgSprite from '../components/SvgSprite.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Browse upcoming real estate auctions in Massachusetts. Live bids, dates, deposits, and auctioneer details — updated daily.',
  canonical = Astro.url.href,
  ogImage,
  noindex = false,
} = Astro.props;

const pageTitle =
  title === 'Auctions'
    ? 'Upcoming Property Auctions in Massachusetts | Auction & Company'
    : `${title} | Auction & Company`;

const origin = Astro.url.origin;
const ogImageURL = ogImage ?? `${origin}/og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <ClientRouter />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#09090b" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Auction & Company" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Astro 6 Fonts API — Satoshi (Fontshare) + JetBrains Mono (Fontsource) -->
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" preload />

    <!-- Organization + WebSite structured data -->
    <script type="application/ld+json" is:inline>{JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Auction & Company",
        "url": "https://auctionandcompany.com",
        "description": "Browse upcoming real estate auctions in Massachusetts. Live bids, dates, deposits, and auctioneer details — updated daily.",
        "areaServed": { "@type": "State", "name": "Massachusetts" }
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Auction & Company",
        "url": "https://auctionandcompany.com",
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://auctionandcompany.com/?q={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
      }
    ])}</script>

    <script is:inline>
      const applyTheme = () => {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute(
          'data-theme',
          saved || (prefersDark ? 'dark' : 'light')
        );
      };
      // Run immediately on first load
      applyTheme();
      // Re-run immediately after Astro swaps the DOM on navigation
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body transition:animate="none">
    <div id="top-loader" class="top-loader" transition:persist="top-loader"></div>
    <SvgSprite />
    <Topbar />
    <main class="main-content">
      <slot />
    </main>

    <script is:inline>
      if (!window.__loaderInitialized) {
        document.addEventListener('astro:before-preparation', () => {
          document.getElementById('top-loader')?.classList.add('loading');
        });
        document.addEventListener('astro:page-load', () => {
          const loader = document.getElementById('top-loader');
          if (loader) {
            loader.classList.add('done');
            setTimeout(() => {
              loader.classList.remove('loading', 'done');
            }, 300);
          }
        });
        window.__loaderInitialized = true;
      }
    </script>
    <script src="../scripts/card-animations.ts"></script>
  </body>
</html>
