---
import Layout from '../layouts/Layout.astro';
import AuctionGrid from '../components/AuctionGrid.astro';
import MapSplitView from '../components/MapSplitView.astro';
import ViewToggle from '../components/ViewToggle.astro';
import axios, { AxiosError } from 'axios';

const LIMIT = 20;
const apiUrl = import.meta.env.VITE_API_URL ?? 'http://localhost:8080';
let auctions: any[] = [];
let error: string | null = null;

// todayET returns the current calendar date in America/New_York as a
// comparable string ("YYYY-MM-DD") using the Intl API.
function todayET(): string {
  return new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' });
}

// filterPastAuctions removes auctions whose date has already passed in ET.
// date strings arrive from the API as "Apr 2, 2026" (Jan 2, 2006 format).
// Rows with no date are kept — they have no scheduled date, not a past one.
function filterPastAuctions(list: any[]): any[] {
  const today = todayET(); // "2026-04-03"
  return list.filter((a) => {
    if (!a.date) return true;
    const parsed = new Date(a.date);
    if (isNaN(parsed.getTime())) return true; // unparseable → keep
    // toLocaleDateString('en-CA') gives "YYYY-MM-DD" — safe string compare
    return parsed.toLocaleDateString('en-CA') >= today;
  });
}

try {
  console.log('Fetching auctions from:', apiUrl);
  const response = await axios.get(`${apiUrl}/auctions?limit=${LIMIT}&offset=0`, {
    headers: { 'Content-Type': 'application/json' },
  });
  auctions = filterPastAuctions(response.data.auctions);
} catch (e) {
  console.error('Error fetching auctions:', e);
  if (e instanceof AxiosError) {
    error = e.response?.data?.message || e.message;
  } else if (e instanceof Error) {
    error = e.message;
  } else {
    error = 'An unexpected error occurred';
  }
}

const hasMore = auctions.length === LIMIT;
---

<Layout
  title="Auctions"
  description="Browse upcoming real estate auctions in Massachusetts. Dates, deposits, and auctioneer details — updated daily."
>
  {/* Hidden config element — client scripts read SSR data from here via data-* attributes */}
  <div
    id="page-config"
    data-api-url={apiUrl}
    data-initial-auctions={JSON.stringify(auctions)}
    data-has-more={String(hasMore)}
    data-limit={String(LIMIT)}
    hidden
  />

  <div class="auctions-page" id="auctions-page">
    <div class="container">
      <header class="page-header">
        <h1>Upcoming Property Auctions</h1>
        <p class="text-secondary">Massachusetts · updated daily</p>
      </header>

      {error ? (
        <div class="error-state">
          <i class="fas fa-exclamation-circle" />
          <h2>Error loading auctions</h2>
          <p>{error}</p>
          <button onclick="window.location.reload()" class="btn btn-primary">
            <i class="fas fa-redo" />
            Try Again
          </button>
        </div>
      ) : (
        <AuctionGrid auctions={auctions} hasMore={hasMore} />
      )}
    </div>
  </div>

  <MapSplitView auctions={auctions} hasMore={hasMore} apiUrl={apiUrl} />
  <ViewToggle />
</Layout>

<script>
  import '../scripts/main';
</script>

<script>
  /**
   * Browser-side stale-card purge.
   *
   * Runs after the DOM is ready so it catches cards that were rendered by
   * SSR and then served from a CDN cache hours (or days) later.
   *
   * Each .auction-card carries a data-date="YYYY-MM-DD" attribute stamped
   * at render time by Card.astro.  We compare that against today's date in
   * America/New_York — if the auction date is in the past, the card is
   * removed from the DOM before the user ever sees it.
   *
   * ISO-8601 strings compare correctly as plain strings (lexicographic order
   * matches chronological order), so no Date parsing is needed here.
   */
  document.addEventListener('DOMContentLoaded', () => {
    const todayET = new Date().toLocaleDateString('en-CA', {
      timeZone: 'America/New_York',
    }); // → "2026-04-03"

    document
      .querySelectorAll<HTMLElement>('.auction-card[data-date]')
      .forEach((card) => {
        const d = card.dataset.date;
        // Empty data-date means no scheduled date — keep the card.
        if (d && d < todayET) {
          card.remove();
        }
      });
  });
</script>

<style>
  .auctions-page {
    padding-top: var(--spacing-2xl);
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .page-header h1 {
    font-size: 2.25rem;
    margin-bottom: var(--spacing-xs);
  }

  .error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--spacing-2xl);
    gap: var(--spacing-md);
  }

  .error-state i {
    font-size: 3rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-md);
  }

  .error-state h2 {
    font-size: 1.5rem;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-sm);
  }

  .error-state p {
    color: var(--color-text-secondary);
    max-width: 400px;
    margin-bottom: var(--spacing-lg);
  }
</style>
