---
import Layout from '../layouts/Layout.astro';
import AuctionGrid from '../components/AuctionGrid.astro';
import MapSplitView from '../components/MapSplitView.astro';
import ViewToggle from '../components/ViewToggle.astro';
import axios, { AxiosError } from 'axios';

const LIMIT = 20;
const apiUrl = import.meta.env.VITE_API_URL ?? 'http://localhost:8080';
let auctions: any[] = [];
let error: string | null = null;

try {
  const response = await axios.get(`${apiUrl}/auctions?limit=${LIMIT}&offset=0`, {
    headers: { 'Content-Type': 'application/json' },
  });
  auctions = response.data.auctions;
} catch (e) {
  console.error('Error fetching auctions:', e);
  if (e instanceof AxiosError) {
    error = e.response?.data?.message || e.message;
  } else if (e instanceof Error) {
    error = e.message;
  } else {
    error = 'An unexpected error occurred';
  }
}

const hasMore = auctions.length === LIMIT;
---

<Layout
  title="Auctions"
  description="Browse upcoming real estate auctions in Massachusetts. Dates, deposits, and auctioneer details — updated daily."
>
  {/* Hidden config element — client scripts read SSR data from here via data-* attributes */}
  <div
    id="page-config"
    data-api-url={apiUrl}
    data-initial-auctions={JSON.stringify(auctions)}
    data-has-more={String(hasMore)}
    data-limit={String(LIMIT)}
    hidden
  />

  <div class="auctions-page">
    <div class="container">
      <header class="page-header">
        <h1>Upcoming Property Auctions</h1>
        <p class="text-secondary">Massachusetts · updated daily</p>
      </header>

      {error ? (
        <div class="error-state">
          <i class="fas fa-exclamation-circle" />
          <h2>Error loading auctions</h2>
          <p>{error}</p>
          <button onclick="window.location.reload()" class="btn btn-primary">
            <i class="fas fa-redo" />
            Try Again
          </button>
        </div>
      ) : (
        <AuctionGrid auctions={auctions} hasMore={hasMore} />
      )}
    </div>
  </div>

  <MapSplitView auctions={auctions} hasMore={hasMore} apiUrl={apiUrl} />
  <ViewToggle />
</Layout>

<script>
  import '../scripts/main';
</script>

<style>
  .auctions-page {
    padding-top: var(--spacing-2xl);
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .page-header h1 {
    font-size: 2.25rem;
    margin-bottom: var(--spacing-xs);
  }

  .error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--spacing-2xl);
    gap: var(--spacing-md);
  }

  .error-state i {
    font-size: 3rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-md);
  }

  .error-state h2 {
    font-size: 1.5rem;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-sm);
  }

  .error-state p {
    color: var(--color-text-secondary);
    max-width: 400px;
    margin-bottom: var(--spacing-lg);
  }
</style>
