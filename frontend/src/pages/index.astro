---
import '../styles/pages-index.css';
import Layout from '../layouts/Layout.astro';
import AuctionGrid from '../components/AuctionGrid.astro';
import MapSplitView from '../components/MapSplitView.astro';
import ViewToggle from '../components/ViewToggle.astro';
import axios, { AxiosError } from 'axios';

const LIMIT = 20;
const apiUrl = import.meta.env.VITE_API_URL ?? 'http://localhost:8080';
let auctions: any[] = [];
let error: string | null = null;

try {
  console.log('Fetching auctions from:', apiUrl);
  const response = await axios.get(`${apiUrl}/auctions?limit=${LIMIT}&offset=0`, {
    headers: { 'Content-Type': 'application/json' },
  });
  // The backend API already filters out past auctions using the America/New_York timezone
  auctions = response.data.auctions;
} catch (e) {
  console.error('Error fetching auctions:', e);
  if (e instanceof AxiosError) {
    error = e.response?.data?.message || e.message;
  } else if (e instanceof Error) {
    error = e.message;
  } else {
    error = 'An unexpected error occurred';
  }
}

const hasMore = auctions.length === LIMIT;
---

<Layout
  title="Auctions"
  description="Browse upcoming property auctions across Massachusetts — Worcester, Springfield, Boston, Lynn, and more. Live dates, deposit requirements, and auctioneer details updated daily."
>
  {/* Hidden config element — client scripts read SSR data from here via data-* attributes */}
  <div
    id="page-config"
    data-api-url={apiUrl}
    data-initial-auctions={JSON.stringify(auctions)}
    data-has-more={String(hasMore)}
    data-limit={String(LIMIT)}
    hidden
  />

  <div class="auctions-page" id="auctions-page">
    <div class="container">
      <header class="page-header">
        <h1>Upcoming Property Auctions</h1>
        <p class="text-secondary">Massachusetts · updated daily</p>
      </header>

      <div class="search-bar-wrap">
        <div class="search-bar">
          <svg class="search-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input
            id="auction-search"
            type="search"
            placeholder="Search by address or city…"
            aria-label="Search auctions by address or city"
            autocomplete="off"
          />
          <button id="search-clear-btn" class="search-clear" aria-label="Clear search" style="display:none">×</button>
        </div>
      </div>

      {error ? (
        <div class="error-state">
          <i class="fas fa-exclamation-circle" />
          <h2>Error loading auctions</h2>
          <p>{error}</p>
          <button onclick="window.location.reload()" class="btn btn-primary">
            <i class="fas fa-redo" />
            Try Again
          </button>
        </div>
      ) : (
        <AuctionGrid auctions={auctions} hasMore={hasMore} />
      )}
    </div>
  </div>

  <MapSplitView auctions={auctions} hasMore={hasMore} apiUrl={apiUrl} />
  <ViewToggle />

  <script type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do property auctions work in Massachusetts?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Massachusetts property auctions are typically foreclosure sales conducted by licensed auctioneers. A deposit (usually $5,000–$25,000) is required on the day of the auction, with the balance due within 30 days. Properties are sold as-is with no inspection contingency."
        }
      },
      {
        "@type": "Question",
        "name": "What deposit do I need for a Massachusetts property auction?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Deposit requirements vary by property but typically range from $5,000 to $25,000, payable by certified check or cash on auction day. The deposit amount is listed on each auction listing."
        }
      },
      {
        "@type": "Question",
        "name": "Where are upcoming property auctions in Massachusetts listed?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Auction & Company aggregates upcoming Massachusetts property auctions from licensed auctioneers including Bay State Auction, Patriot Auctions, Sullivan & Sullivan, and others — updated daily with dates, addresses, and deposit requirements."
        }
      },
      {
        "@type": "Question",
        "name": "Can I inspect a property before a foreclosure auction?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Generally no — Massachusetts foreclosure auction properties are sold as-is with no inspection contingency. Bidders are encouraged to do a drive-by and research the property at the Registry of Deeds before bidding."
        }
      }
    ]
  })}</script>
</Layout>

<script>
  import '../scripts/main';
  import { initSearch } from '../scripts/search';
  document.addEventListener('DOMContentLoaded', initSearch);
</script>

<script>
  /**
   * Browser-side stale-card purge.
   *
   * Runs after the DOM is ready so it catches cards that were rendered by
   * SSR and then served from a CDN cache hours (or days) later.
   *
   * Each .auction-card carries a data-date="YYYY-MM-DD" attribute stamped
   * at render time by Card.astro.  We compare that against today's date in
   * America/New_York — if the auction date is in the past, the card is
   * removed from the DOM before the user ever sees it.
   *
   * ISO-8601 strings compare correctly as plain strings (lexicographic order
   * matches chronological order), so no Date parsing is needed here.
   */
  document.addEventListener('DOMContentLoaded', () => {
    const todayET = new Date().toLocaleDateString('en-CA', {
      timeZone: 'America/New_York',
    }); // → "2026-04-03"

    document
      .querySelectorAll<HTMLElement>('.auction-card[data-date]')
      .forEach((card) => {
        const d = card.dataset.date;
        // Empty data-date means no scheduled date — keep the card.
        if (d && d < todayET) {
          card.remove();
        }
      });
  });
</script>
