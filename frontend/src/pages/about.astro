---
import '../styles/about.css';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About Auction & Company"
  description="Learn how Auction & Company tracks upcoming Massachusetts property auctions — data sources, update frequency, deposit info, and how to use the site."
>
  <div class="about-page">
    <div class="container">
      <header class="page-header">
        <h1>About Auction & Company</h1>
        <p class="text-secondary">Learn about our platform and how it works</p>
      </header>

      <div class="content-card">
        <section class="about-section">
          <h2>
            <svg class="icon" aria-hidden="true"><use href="#icon-gavel"></use></svg>
            What We Do
          </h2>
          <p>
            Auctions are a dynamic and exciting way to buy and sell properties. Our platform brings
            together buyers and sellers in a competitive environment, ensuring fair market value
            through transparent bidding processes.
          </p>
        </section>

        <section class="about-section">
          <h2>
            <svg class="icon" aria-hidden="true"><use href="#icon-users"></use></svg>
            Who We Serve
          </h2>
          <p>
            Whether you're a seasoned real estate investor or new to property auctions, our platform
            provides the tools and information you need to participate with confidence. We cater to
            both buyers looking for opportunities and sellers seeking the best value for their
            properties.
          </p>
        </section>

        <section class="about-section">
          <h2>
            <svg class="icon" aria-hidden="true"><use href="#icon-lightbulb"></use></svg>
            Our Features
          </h2>
          <ul class="features-list">
            <li>
              <svg class="icon" aria-hidden="true"><use href="#icon-search"></use></svg>
              <div>
                <h3>Easy Search</h3>
                <p>Find relevant auctions quickly with our intuitive search system</p>
              </div>
            </li>
            <li>
              <svg class="icon" aria-hidden="true"><use href="#icon-heart"></use></svg>
              <div>
                <h3>Favorites</h3>
                <p>Save and track auctions you're interested in</p>
              </div>
            </li>
            <li>
              <svg class="icon" aria-hidden="true"><use href="#icon-bell"></use></svg>
              <div>
                <h3>Updates</h3>
                <p>Stay informed about auction status changes and important dates</p>
              </div>
            </li>
          </ul>
        </section>

        <section class="about-section">
          <h2>
            <svg class="icon" aria-hidden="true"><use href="#icon-handshake"></use></svg>
            Get Started
          </h2>
          <p>
            Ready to explore the world of property auctions? Create an account to start tracking
            auctions and participating in bids. Our platform makes it easy to find and manage your
            auction interests.
          </p>
          <div class="cta-buttons">
            <a href="/register" class="btn btn-primary">
              <svg class="icon" aria-hidden="true"><use href="#icon-user-plus"></use></svg>
              Create Account
            </a>
            <a href="/" class="btn btn-secondary">
              <svg class="icon" aria-hidden="true"><use href="#icon-search"></use></svg>
              Browse Auctions
            </a>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>
