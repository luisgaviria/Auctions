---
import '../styles/favorites.css';
import Layout from '../layouts/Layout.astro';

const apiUrl = import.meta.env.VITE_API_URL ?? 'http://localhost:8080';
---

<Layout title="My Favorites" noindex={true}>
  {/* Hidden config — client script reads apiUrl from here */}
  <div id="favorites-config" data-api-url={apiUrl} hidden />

  <div class="favorites-page">
    <div class="container">
      <header class="page-header">
        <h1>My Favorites</h1>
        <p class="text-secondary">Auctions you're tracking</p>
      </header>

      <div class="card-grid" id="favorites-container">
        <div class="empty-state">
          <svg class="icon" aria-hidden="true"><use href="#icon-heart-o"></use></svg>
          <h2>No favorites yet</h2>
          <p>Mark auctions as favorites to track them here.</p>
          <a href="/" class="btn btn-primary">Browse Auctions</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import '../scripts/favorites-page';
</script>
