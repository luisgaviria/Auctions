---
import Layout from '../layouts/Layout.astro';

const apiUrl = import.meta.env.VITE_API_URL ?? 'http://localhost:8080';
---

<Layout title="My Favorites" noindex={true}>
  {/* Hidden config — client script reads apiUrl from here */}
  <div id="favorites-config" data-api-url={apiUrl} hidden />

  <div class="favorites-page">
    <div class="container">
      <header class="page-header">
        <h1>My Favorites</h1>
        <p class="text-secondary">Auctions you're tracking</p>
      </header>

      <div class="card-grid" id="favorites-container">
        <div class="empty-state">
          <svg class="icon" aria-hidden="true"><use href="#icon-heart-o"></use></svg>
          <h2>No favorites yet</h2>
          <p>Mark auctions as favorites to track them here.</p>
          <a href="/" class="btn btn-primary">Browse Auctions</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import '../scripts/favorites-page';
</script>

<style>
  .favorites-page {
    padding-top: calc(4rem + var(--spacing-xl));
    padding-bottom: var(--spacing-2xl);
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .page-header h1 {
    font-size: 2rem;
    margin-bottom: var(--spacing-xs);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
    padding-top: var(--spacing-lg);
    min-height: 300px;
  }

  .empty-state,
  .error-state,
  .loading-state {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--spacing-2xl);
    gap: var(--spacing-md);
  }

  .empty-state .icon,
  .error-state .icon {
    font-size: 2.5rem;
    color: var(--color-text-muted);
  }

  .empty-state h2,
  .error-state h2 {
    font-size: 1.25rem;
    color: var(--color-text-primary);
  }

  .empty-state p,
  .error-state p {
    color: var(--color-text-secondary);
    max-width: 400px;
  }

  .page-spinner {
    width: 2rem;
    height: 2rem;
    border: 2px solid var(--color-border);
    border-top-color: var(--color-accent);
    border-radius: var(--radius-full);
    animation: spin 0.8s linear infinite;
    margin-bottom: var(--spacing-sm);
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 1024px) {
    .card-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .page-header h1 { font-size: 1.625rem; }
    .card-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }
</style>
