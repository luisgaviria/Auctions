---
import '../styles/auctionGrid.css';
import Card from './Card.astro';

interface Props {
  auctions: any[];
  hasMore: boolean;
}
const { auctions, hasMore } = Astro.props;
---

<div id="grid-view">
  <div class="card-grid" id="auctions-grid">
    {auctions.length === 0 ? (
      <div class="empty-state">
        <i class="fas fa-search" />
        <h2>No auctions available</h2>
        <p>There are currently no auctions listed. Please check back later.</p>
      </div>
    ) : (
      auctions.map((auction: any) => (
        <Card
          id={auction.id}
          link={auction.link}
          date={auction.date}
          time={auction.time}
          address={auction.address}
          city={auction.city}
          state={auction.state}
          status={auction.status}
          deposit={auction.deposit}
          siteName={auction.site_name}
          zillowUrl={auction.zillow_url}
          streetViewUrl={auction.street_view_url}
          registryUrl={auction.registry_url}
          registryDeepLink={auction.registry_deep_link}
          registryBook={auction.registry_book}
          registryPage={auction.registry_page}
        />
      ))
    )}
  </div>
  <div class="load-more-wrapper">
    <button
      id="load-more-btn"
      class="btn btn-primary"
      style={hasMore ? '' : 'display:none'}
    >
      Load More
    </button>
  </div>
</div>
