---
interface Props {
  id: number;
  link: string;
  date: string;
  time: string;
  address: string;
  city: string;
  state: string;
  status: string;
  deposit: string;
  siteName: string;
  logo?: string;
  zillowUrl?: string;
  streetViewUrl?: string;
  registryUrl?: string;
  nearbyLandmarks?: string[];
}

const { id, link, date, time: auctionTime, address, city, state, status, deposit, siteName, logo, zillowUrl, streetViewUrl, registryUrl, nearbyLandmarks } =
  Astro.props;

function toISODate(str: string): string {
  if (!str) return '';
  try { return new Date(str).toISOString().split('T')[0]; } catch { return ''; }
}

function statusCategory(s: string): 'active' | 'postponed' | 'muted' {
  const lower = s?.toLowerCase() ?? '';
  if (lower.includes('postponed')) return 'postponed';
  if (!s || lower === 'date tbd' || lower === 'tbd') return 'muted';
  return 'active';
}

function formatSiteName(s: string): string {
  if (!s) return '';
  return s.replace(/([a-z])([A-Z])/g, '$1 $2')
    .split(/[\s_-]+/)
    .map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
    .join(' ');
}

// Parse deposit string like "$5,000" → 5000 for schema price field.
function parseDeposit(raw: string): number | undefined {
  if (!raw) return undefined;
  const n = parseFloat(raw.replace(/[^0-9.]/g, ''));
  return isNaN(n) ? undefined : n;
}

const isoDate = toISODate(date);
const depositAmount = parseDeposit(deposit);
const displayAuctioneer = formatSiteName(siteName);

const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: address,
  description: `Foreclosure auction for ${address}${city ? `, ${city}` : ''}${state ? `, ${state}` : ''}${isoDate ? ` scheduled for ${date}` : ''}.`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: address,
    addressLocality: city || undefined,
    addressRegion: state || 'MA',
    addressCountry: 'US',
  },
  ...(depositAmount !== undefined && { price: depositAmount, priceCurrency: 'USD' }),
  ...(isoDate && { availabilityStarts: isoDate }),
  ...(link && { url: link }),
  ...(displayAuctioneer && { offeredBy: { '@type': 'Organization', name: displayAuctioneer } }),
};

const schemaJson = JSON.stringify(schema).replace(/</g, '\\u003c');
const statusCat = statusCategory(status);
const displayStatus = status || 'On Schedule';
---

<div class="auction-card" data-date={toISODate(date)}>
  <!-- Spotlight overlay — position driven by --mouse-x/--mouse-y via JS -->
  <div class="card-spotlight" aria-hidden="true"></div>

  <div class="card-inner">

    <!-- Header: status dot + auctioneer -->
    <div class="card-header">
      <div class="status-indicator" data-status={statusCat}>
        <span class="status-dot"></span>
        <span class="status-text">{displayStatus}</span>
      </div>
      {displayAuctioneer && <span class="auctioneer-label">{displayAuctioneer}</span>}
    </div>

    <!-- Address block -->
    <div class="card-address-block">
      <div class="property-address">{address || 'Address not available'}</div>
      {city && state && <p class="location-line">{city}, {state}</p>}
    </div>

    <!-- Data row: value above label -->
    <div class="card-data-row">
      <div class="data-cell">
        <span class="data-value">{date || '—'}</span>
        <span class="data-label">Date</span>
      </div>
      <div class="data-cell">
        {auctionTime
          ? <span class="data-value">{auctionTime}</span>
          : <span class="data-value data-value--tbd">TBD</span>}
        <span class="data-label">Time</span>
      </div>
      <div class="data-cell">
        <span class="data-value">{deposit || '—'}</span>
        <span class="data-label">Deposit</span>
      </div>
    </div>

    <!-- Footer -->
    <div class="card-footer">
      <button
        class="favorite-btn"
        data-auction-id={id}
        data-loading="false"
        title="Add to favorites"
        aria-pressed="false"
        aria-label="Add to favorites"
      >
        <svg class="icon" aria-hidden="true"><use href="#icon-heart-o"></use></svg>
        <div class="fav-spinner"></div>
      </button>
    </div>

  </div>

  <!-- Research toolbar: all buttons open URLs in a new tab -->
  <div class="card-research">
    {link && (
      <button type="button" class="research-btn research-btn--auction" title="View auction listing" aria-label="View auction listing"
        onclick={`window.open('${link}','_blank','noopener,noreferrer')`}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M19 19H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/></svg>
        <span>Listing</span>
      </button>
    )}
    {zillowUrl && (
      <button type="button" class="research-btn research-btn--zillow" title="View on Zillow" aria-label="View on Zillow"
        onclick={`window.open('${zillowUrl}','_blank','noopener,noreferrer')`}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M12 2L2 9.5l1.5 1L12 4.3l8.5 6.2 1.5-1L12 2zm0 3.8L4 11.5V21h6v-6h4v6h6V11.5L12 5.8z"/></svg>
        <span>Zillow</span>
      </button>
    )}
    {streetViewUrl && (
      <button type="button" class="research-btn research-btn--streetview" title="View on Google Maps" aria-label="View on Google Maps"
        onclick={`window.open('${streetViewUrl}','_blank','noopener,noreferrer')`}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        <span>Maps</span>
      </button>
    )}
    {registryUrl && (
      <button type="button" class="research-btn research-btn--registry" title="View Registry of Deeds" aria-label="View Registry of Deeds"
        onclick={`window.open('${registryUrl}','_blank','noopener,noreferrer')`}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11zM8 15h8v2H8zm0-4h8v2H8z"/></svg>
        <span>Registry</span>
      </button>
    )}
  </div>

  {/* Semantic fact sheet — visually hidden, always present for LLMs and crawlers */}
  <div class="sr-only" aria-hidden="true" data-ai-summary="true">
    <p>This property is located at {address}{city ? `, ${city}` : ''}{state ? `, ${state}` : ''}.</p>
    {city && <p>The auction is in {city}, {state || 'Massachusetts'}.</p>}
    <p>
      {isoDate
        ? `The auction is scheduled for ${date}${auctionTime ? ` at ${auctionTime}` : ''}.`
        : 'The auction date has not yet been confirmed.'}
    </p>
    <p>The current listing status is {status || 'On Schedule'}.</p>
    {displayAuctioneer && <p>The auctioneer conducting this sale is {displayAuctioneer}.</p>}
    <p>
      {deposit
        ? `The required deposit is ${deposit}, payable by bank check.`
        : 'Deposit terms have not been specified.'}
    </p>
    {(nearbyLandmarks && nearbyLandmarks.length > 0) && (
      <p>Nearby landmarks include: {nearbyLandmarks.join(', ')}.</p>
    )}
    {link && <p>Full auction details are available at the listing URL.</p>}
    {zillowUrl && <p>Property valuation data is available on Zillow.</p>}
    {registryUrl && <p>Deed and ownership records are available through the Registry of Deeds.</p>}
  </div>

</div>

<script type="application/ld+json" set:html={schemaJson} />

<!-- Mouse-follow spotlight — runs once per page, handles all cards -->
<script>
  if (!(window as any).__auctionCardSpotlightInit) {
    (window as any).__auctionCardSpotlightInit = true;
    document.addEventListener('mousemove', (e) => {
      const card = (e.target as Element).closest('.auction-card') as HTMLElement | null;
      if (!card) return;
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${e.clientX - r.left}px`);
      card.style.setProperty('--mouse-y', `${e.clientY - r.top}px`);
    });
  }
</script>

<style is:global>
  /* Visually hidden but present in DOM for screen readers, crawlers, and LLMs */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ═══════════════════════════════════════════════
     Auction Card — Vercel-style
     ═══════════════════════════════════════════════ */

  .auction-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: inherit;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .auction-card:hover {
    border-color: var(--color-accent);
  }

  /* Spotlight element kept in HTML but hidden — no background glow */
  .auction-card .card-spotlight { display: none; }

  .auction-card .card-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.375rem 1.375rem 1.125rem;
    gap: 1rem;
  }

  /* ── Header ── */
  .auction-card .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .auction-card .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Colored dot */
  .auction-card .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--color-text-muted);
  }

  .auction-card .status-indicator[data-status='active'] .status-dot {
    background: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 20%, transparent);
    animation: card-dot-pulse 2.4s ease-in-out infinite;
  }

  .auction-card .status-indicator[data-status='postponed'] .status-dot {
    background: var(--color-warning);
  }

  @keyframes card-dot-pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 40%, transparent); }
    50%       { box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-accent) 0%, transparent); }
  }

  .auction-card .status-text {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 140px;
  }

  .auction-card .status-indicator[data-status='active'] .status-text {
    color: var(--color-accent);
  }

  .auction-card .status-indicator[data-status='postponed'] .status-text {
    color: var(--color-warning);
  }

  /* Auctioneer name */
  .auction-card .auctioneer-label {
    font-family: var(--font-mono);
    font-size: 0.675rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100px;
    flex-shrink: 0;
  }

  /* ── Address block ── */
  .auction-card .card-address-block {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
  }

  .auction-card .property-address {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.3;
    color: var(--color-text-primary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .auction-card .location-line {
    font-size: 14px;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 700;
    font-family: var(--font-mono);
    margin: 0;
  }

  /* ── Data row ── */
  .auction-card .card-data-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
    gap: 0;
    transition: border-color 0.2s ease;
  }

  .auction-card:hover .card-data-row {
    border-top-color: var(--color-accent);
  }

  .auction-card .data-cell {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-right: 1rem;
    border-right: 1px solid var(--color-border);
  }

  .auction-card .data-cell:first-child { padding-left: 0; }
  .auction-card .data-cell:last-child  { border-right: none; padding-right: 0; padding-left: 1rem; }
  .auction-card .data-cell:not(:first-child):not(:last-child) { padding-left: 1rem; }

  .auction-card .data-value {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .auction-card .data-value--tbd {
    color: var(--color-text-muted);
    font-weight: 400;
    font-style: italic;
  }

  .auction-card .data-label {
    font-family: var(--font-mono);
    font-size: 0.675rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    line-height: 1;
  }

  /* ── Footer ── */
  .auction-card .card-footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 0.25rem;
  }

  .auction-card .favorite-btn {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 6px;
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    transition: all 0.15s ease;
    position: relative;
    flex-shrink: 0;
  }

  .auction-card .favorite-btn:hover {
    background: var(--color-danger);
    color: #fff;
    border-color: var(--color-danger);
  }

  .auction-card .favorite-btn[aria-pressed='true'] {
    color: var(--color-danger);
    border-color: var(--color-danger);
  }

  .auction-card .favorite-btn[data-loading='true'] .icon { opacity: 0; }

  .auction-card .fav-spinner {
    display: none;
    position: absolute;
    width: 0.875rem;
    height: 0.875rem;
    border: 1.5px solid var(--color-border);
    border-radius: 50%;
    border-top-color: var(--color-accent);
    animation: fav-spin 0.6s linear infinite;
  }

  .auction-card .favorite-btn[data-loading='true'] .fav-spinner { display: block; }

  @keyframes fav-spin { to { transform: rotate(360deg); } }

  /* ── Research toolbar — sits outside card-inner, pinned to card bottom ── */
  .auction-card .card-research {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    padding: 0.75rem 1.375rem;
    border-top: 1px solid var(--color-border);
  }

  .auction-card .research-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.375rem 0.25rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
    overflow: hidden;
  }

  .auction-card .research-btn--auction:hover {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
  }

  .auction-card .research-btn--zillow:hover {
    background: #006aff;
    color: #fff;
    border-color: #006aff;
  }

  .auction-card .research-btn--streetview:hover {
    background: #ea4335;
    color: #fff;
    border-color: #ea4335;
  }

  .auction-card .research-btn--registry:hover {
    background: #1a7340;
    color: #fff;
    border-color: #1a7340;
  }
</style>
