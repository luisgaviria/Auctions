---
import '../styles/Topbar.css';
const apiUrl = import.meta.env.VITE_API_URL;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="nav-bar">

    <!-- Left: badge + wordmark -->
    <a href="/" class="nav-brand" aria-label="Auction & Company home">
      <span class="brand-badge">AC</span>
      <!-- <span class="brand-name">AUCTION&COMPANY</span> -->
    </a>

    <!-- Right: links + actions (desktop) -->
    <div class="nav-right">
      <nav class="nav-links" aria-label="Site navigation">
        <a href="/"              class={`nav-link${isActive('/')              ? ' active' : ''}`}>Home</a>
        <a href="/massachusetts" class={`nav-link${isActive('/massachusetts') ? ' active' : ''}`}>Directory</a>
        <a href="/favorites"     class={`nav-link${isActive('/favorites')     ? ' active' : ''}`}
           id="favLink" style="display:none">Favorites</a>
        <a href="/about"         class={`nav-link${isActive('/about')         ? ' active' : ''}`}>About</a>
      </nav>

      <div class="nav-actions">
        <button id="theme-toggle" class="nav-icon-btn" title="Toggle dark mode" aria-label="Toggle dark mode">
          <svg class="icon" id="theme-icon" aria-hidden="true"><use id="theme-use" href="#icon-moon"></use></svg>
        </button>
        <div class="nav-auth" id="authLinks"></div>
      </div>
    </div>

    <!-- Mobile: theme + burger -->
    <div class="nav-mobile-actions">
      <button id="theme-toggle-m" class="nav-icon-btn" title="Toggle dark mode" aria-label="Toggle dark mode">
        <svg class="icon" id="theme-icon-m" aria-hidden="true"><use id="theme-use-m" href="#icon-moon"></use></svg>
      </button>
      <button class="nav-burger" id="navBurger" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span><span></span>
      </button>
    </div>

  </div>

  <!-- Mobile menu dropdown -->
  <div class="mobile-menu" id="mobileMenu" hidden aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <a href="/"              class={`mobile-link${isActive('/')              ? ' active' : ''}`}>
        <svg class="icon" aria-hidden="true"><use href="#icon-home"></use></svg> Home
      </a>
      <a href="/massachusetts" class={`mobile-link${isActive('/massachusetts') ? ' active' : ''}`}>
        <svg class="icon" aria-hidden="true"><use href="#icon-list"></use></svg> Directory
      </a>
      <a href="/favorites"     class={`mobile-link${isActive('/favorites')     ? ' active' : ''}`}
         id="mobFavLink" style="display:none">
        <svg class="icon" aria-hidden="true"><use href="#icon-heart-o"></use></svg> Favorites
      </a>
      <a href="/about"         class={`mobile-link${isActive('/about')         ? ' active' : ''}`}>
        <svg class="icon" aria-hidden="true"><use href="#icon-info-circle"></use></svg> About
      </a>
    </nav>
    <div class="mobile-divider"></div>
    <div id="mobileAuthLinks"></div>
  </div>
</header>

<script define:vars={{ apiUrl }} data-astro-rerun>
  /* ── Auth state ── */
  const token = localStorage.getItem('jwt_token');

  const authEl    = document.getElementById('authLinks');
  const mobileAuth= document.getElementById('mobileAuthLinks');
  const favLink   = document.getElementById('favLink');
  const mobFavLink= document.getElementById('mobFavLink');

  if (token) {
    authEl.innerHTML = `
      <span class="nav-link nav-logout" onclick="handleLogout()" role="button" tabindex="0">
        Logout
      </span>`;
    mobileAuth.innerHTML = `
      <span class="mobile-link mobile-logout" onclick="handleLogout()" role="button" tabindex="0">
        <svg class="icon" aria-hidden="true"><use href="#icon-sign-out"></use></svg> Logout
      </span>`;
    if (favLink)    favLink.style.display    = '';
    if (mobFavLink) mobFavLink.style.display = '';
  } else {
    authEl.innerHTML = `
      <a href="/login"    class="nav-link">Login</a>
      <a href="/register" class="nav-link nav-register">Register</a>`;
    mobileAuth.innerHTML = `
      <a href="/login"    class="mobile-link"><svg class="icon" aria-hidden="true"><use href="#icon-sign-in"></use></svg> Login</a>
      <a href="/register" class="mobile-link mobile-register"><svg class="icon" aria-hidden="true"><use href="#icon-user-plus"></use></svg> Register</a>`;
  }

  async function handleLogout() {
    try {
      await fetch(`${apiUrl}/auth/logout`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${localStorage.getItem('jwt_token')}`,
        },
        credentials: 'include',
      });
    } catch (_) {}
    localStorage.removeItem('jwt_token');
    window.location.href = '/login';
  }
  window.handleLogout = handleLogout;

  /* ── Theme toggle (synced across both desktop + mobile buttons) ── */
  function setThemeIcons(t) {
    const newIcon = t === 'dark' ? 'sun' : 'moon';
    ['theme-use', 'theme-use-m'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.setAttribute('href', '#icon-' + newIcon);
    });
  }
  setThemeIcons(document.documentElement.getAttribute('data-theme') || 'light');

  function toggleTheme() {
    const next = (document.documentElement.getAttribute('data-theme') || 'light') === 'dark'
      ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    setThemeIcons(next);
  }
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-m')?.addEventListener('click', toggleTheme);

  /* ── Mobile burger ── */
  const burger = document.getElementById('navBurger');
  const mobileMenu = document.getElementById('mobileMenu');

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.classList.toggle('open', !open);
    mobileMenu.hidden = open;
    mobileMenu.setAttribute('aria-hidden', String(open));
  });

  document.addEventListener('click', (e) => {
    if (
      mobileMenu &&
      !mobileMenu.hidden &&
      !burger.contains(e.target) &&
      !mobileMenu.contains(e.target)
    ) {
      burger.setAttribute('aria-expanded', 'false');
      burger.classList.remove('open');
      mobileMenu.hidden = true;
      mobileMenu.setAttribute('aria-hidden', 'true');
    }
  });

  mobileMenu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      burger.setAttribute('aria-expanded', 'false');
      burger.classList.remove('open');
      mobileMenu.hidden = true;
      mobileMenu.setAttribute('aria-hidden', 'true');
    })
  );

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu && !mobileMenu.hidden) {
      burger.setAttribute('aria-expanded', 'false');
      burger.classList.remove('open');
      mobileMenu.hidden = true;
      mobileMenu.setAttribute('aria-hidden', 'true');
      burger.focus();
    }
  });
</script>


