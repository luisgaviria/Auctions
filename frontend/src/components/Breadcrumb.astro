---
import '../styles/Breadcrumb.css';
interface Crumb {
  label: string;
  href?: string; // omit for the current (last) crumb
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;

// BreadcrumbList JSON-LD for Google rich results
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: `https://auctionandcompany.com${c.href}` } : {}),
  })),
};
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    {crumbs.map((crumb, i) => (
      <li>
        {i > 0 && <span class="sep" aria-hidden="true">/</span>}
        {crumb.href
          ? <a href={crumb.href}>{crumb.label}</a>
          : <span aria-current="page">{crumb.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />


